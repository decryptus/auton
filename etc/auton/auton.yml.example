general:
  listen_addr:   127.0.0.1
  # New installations require credentials; see README migration notes.
  auth_mode: required
  listen_port:   8666
  max_workers:   5
  max_requests:  5000
  max_life_time: 3600
  lock_timeout:  60
  result_ttl:    3600
  max_jobs:      128
  max_output_bytes: 1048576
  # Optional durable local jobs; separate file from authentication.
  # Private directory must already exist and be owned by the daemon user.
  #job_storage:
  #  backend: sqlite
  #  path: /var/lib/autond/jobs/jobs.db
  #  timeout: 5
  # Local maintenance: queued jobs wait; running jobs finish. Not persisted.
  maintenance: false
  maintenance_reason: ""
  # Requires configured HTTP authentication; empty list denies all changes.
  maintenance_operators: []
  # Optional job lifecycle journal; parent directory must exist and be writable
  # by the daemon user. One daemon process per journal path.
  #journal_path: /var/log/auton/jobs.jsonl
  #journal_max_bytes: 10485760
  #journal_backup_count: 5
  charset:       utf-8
  content_type:  'application/json; charset=utf-8'
  # Persistent auth (requires autond[auth], included in the Docker image).
  # Create the private directory and accounts with autond-auth before first use.
  # Mutually exclusive with auth_basic_file; relative paths use this config's directory.
  #authentication:
  #  backend: sqlite
  #  path: /var/lib/autond/auth/auth.db
  #  timeout: 5
  #auth_basic:      'Restricted'
  #auth_basic_file: '/etc/auton/auton.passwd'
import_modules:
  - modules/job.yml
endpoints:
  si.corp-ansible:
    plugin: subproc
    config:
      prog: ansible-playbook
      timeout: 3600
  si.corp-terraform:
    plugin: subproc
    config:
      prog: terraform
      timeout: 3600
  curl:
    plugin: subproc
    config:
      prog: curl
      timeout: 3600
