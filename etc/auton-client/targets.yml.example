# Client inventory; not an autond server configuration.
# A declared target is never selected implicitly.
# Names: [a-z0-9-]+, 1-32 characters. Quote numeric-only or YAML-reserved names.
targets:
  autond-01: https://autond-01.example.com
  autond-02: https://autond-02.example.com
groups:
  production:
    - autond-01
    - autond-02

# Alternatively, declare the section mappings in separate local files:
#import_targets:
#  - targets/production.yml
#import_groups: groups.yml
# Only the main file may import. Imported files have no targets/groups wrapper.
# Imported and inline names must not overlap.

# Scenario catalogues also import only from this main file:
#import_scenarios: scenarios/deploy.yml.example
#scenario_groups:
#  release: [deploy]
#import_scenario_groups: scenario-groups.yml

# A logical target may use ordered replacement origins (never broadcast):
# Add under targets, then select only deployment for one execution:
#  deployment:
#    uris:
#      - {target: autond-01}
#      - {target: autond-02}
# Individual target references are allowed; group references are forbidden.

# Independent daemon token stores: optional explicit origin-bound profiles.
# Token paths are relative to this file (or the imported profile file).
# Files must be owned by the client user and private (mode 0600).
#credentials:
#  production-one:
#    origins: [https://autond-01.example.com]
#    token_file: tokens/one.token
#  production-two:
#    origins: [https://autond-02.example.com]
#    token_file: tokens/two.token
#import_credentials: auth/profiles.yml
# No nested imports, duplicate origins or mixing profiles with -k / Basic.
