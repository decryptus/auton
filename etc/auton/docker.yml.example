# Local, authenticated quickstart. The host port is loopback-only in Compose.
general:
  listen_addr: 0.0.0.0
  listen_port: 8666
  auth_mode: required
  max_workers: 2
  max_requests: 0
  max_life_time: 0
  lock_timeout: 60
  result_ttl: 3600
  max_jobs: 128
  max_output_bytes: 1048576
  authentication:
    backend: sqlite
    path: /var/lib/autond/auth/auth.db
  job_storage:
    backend: sqlite
    path: /var/lib/autond/jobs/jobs.db
  web_enabled: true
  web_origin: http://127.0.0.1:8666
  maintenance_operators: [operator]
import_modules:
  - modules/job.yml
endpoints:
  hello:
    discovery:
      description: Print a greeting to verify remote execution.
    plugin: subproc
    users:
      operator: true
    config:
      prog: /usr/bin/printf
      args: ['Hello from Auton!\n']
      disallow-args: true
      disallow-argfiles: true
      disallow-envfiles: true
      timeout: 5
